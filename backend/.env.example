# App
APP_NAME="Smart Clinic Tracker"
DEBUG=false

# Database (Neon PostgreSQL — get connection string from https://neon.tech)
DATABASE_URL="postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Database SSL - set to false for local development, true for production (default is true)
# Local Postgres and CI Docker containers typically don't use SSL
DATABASE_SSL=false

# Test database — MUST be a separate local database, never the production URL
# Tests will drop and recreate all tables on every run
TEST_DATABASE_URL="postgresql+asyncpg://test:test@localhost:5432/test"

# Auth
SECRET_KEY="generate-a-random-string-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173"]

# Cloudflare R2 (S3-compatible storage — get from Cloudflare dashboard)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="clinic-tracker"

# Email
# Option A — Mailpit (local dev, no quota, emails visible at http://localhost:8025)
#   Run: docker compose up mailpit
EMAIL_MOCK_MODE=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_REQUIRE_AUTH=false
EMAIL_FROM="noreply@localhost"

# Option B — Gmail SMTP (production)
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
# EMAIL_MOCK_MODE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_REQUIRE_AUTH=true
# GMAIL_USER="yourname@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# EMAIL_FROM="yourname@gmail.com"
